# CosmicPulse Web — server-side configuration (never exposed to the browser).
# Nothing here is required for demo/simulation mode.

# Base URL of the existing CosmicPulse FastAPI ground server (../Aegis/server).
# The browser never calls it directly: Next.js route handlers under /api/ground/*
# proxy requests and keep the session tokens in httpOnly cookies.
GROUND_API_URL=

# Set to "true" when serving over HTTPS so session cookies are Secure.
COOKIE_SECURE=false

# NASA OSDR API base (public, no key). Override only for testing.
OSDR_API_BASE=https://osdr.nasa.gov

# No AI provider keys belong here: the cloud assistant runs on the ground
# server (HF_TOKEN / ANTHROPIC_API_KEY in server/.env). CosmicPulse Web
# forwards questions through /api/ground/assistant.
